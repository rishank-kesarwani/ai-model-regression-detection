# Frontend Environment Configuration (Vercel / Local)
# NOTE: Next.js NEXT_PUBLIC_* variables are inlined at build time.
# Setting NEXT_PUBLIC_ACCESS_ENABLED=true enables demo read-only mode for visitors.
# Setting NEXT_PUBLIC_ACCESS_ENABLED=false requires users to sign in before accessing platform pages.
# This flag is a UX control only; server-side authorization is strictly enforced by the backend.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="AI Model Regression Detection"
NEXT_PUBLIC_ACCESS_ENABLED=true
