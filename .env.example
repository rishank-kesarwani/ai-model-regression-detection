# ==============================================================================
# AI Model Regression Detection Platform - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
APP_URL=https://model-regression.rishankkesarwani.com

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/model_regression?retryWrites=true&w=majority

# Redis (Primary & Fallback)
REDIS_URL=redis://default:password@redis-12345.c10.us-east-1-2.ec2.cloud.redislabs.com:12345
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Authentication & Access Control
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-replace-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PUBLIC_ACCESS_ENABLED=true

# Service Integrations (Shared AI Platform & Notification Service)
AI_PLATFORM_BASE_URL=https://ai-platform.rishankkesarwani.com/api/v1
AI_PLATFORM_MODEL_REGRESSION_API_KEY=mr_aip_live_secret_key_1234567890

NOTIFICATION_SERVICE_BASE_URL=https://notifications.rishankkesarwani.com/api/v1
NOTIFICATION_MODEL_REGRESSION_API_KEY=mr_notif_live_secret_key_1234567890

# GitHub Integration
GITHUB_WEBHOOK_SECRET=gh_webhook_secret_replace_in_production
GITHUB_APP_TOKEN=

# Evaluation Worker Configuration
EVAL_WORKER_CONCURRENCY=5
EVAL_CASE_TIMEOUT_MS=30000
MAX_BATCH_SIZE=500
DATA_RETENTION_DAYS=90

# Frontend Environment Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="AI Model Regression Detection"
NEXT_PUBLIC_ENABLE_ANONYMOUS_RUNS=true
