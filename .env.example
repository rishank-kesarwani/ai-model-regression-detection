# ==============================================================================
# AI Model Regression Detection Platform - Environment Configuration
# ==============================================================================

# Application
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/model_regression?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://default:password@redis-12345.c10.us-east-1-2.ec2.cloud.redislabs.com:12345
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# User Session & JWT Authentication
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-replace-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-replace-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Dynamic Service-to-Service API Key Authentication (Incoming Client Keys)
# Pattern: MODEL_REGRESSION_CLIENT_<SERVICE_NAME>_API_KEY
SERVICE_AUTH_ENABLED=true

# AI PR Review Platform (Calls POST /api/v1/regression/check via x-api-key)
MODEL_REGRESSION_CLIENT_PR_REVIEW_API_KEY=reg_client_pr_review_replace_with_strong_random_secret_min_32_chars

# AI Pipeline Observability (Calls POST /api/v1/evaluations via Authorization: Bearer <key>)
MODEL_REGRESSION_CLIENT_PIPELINE_OBSERVABILITY_API_KEY=reg_client_pipe_obs_replace_with_strong_random_secret_min_32_chars

# Continuous Integration & Automation (Full operator permissions across all projects)
MODEL_REGRESSION_CLIENT_CI_API_KEY=reg_client_ci_replace_with_strong_random_secret_min_32_chars

# Public Read-Only Access
PUBLIC_ACCESS_ENABLED=true

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Outgoing Service Credentials (Backend ONLY - DO NOT expose to frontend)
AI_PLATFORM_BASE_URL=https://ai-platform.rishankkesharwani.com/api/v1
AI_PLATFORM_MODEL_REGRESSION_API_KEY=mr_aip_live_secret_key_replace_in_production

NOTIFICATION_SERVICE_BASE_URL=https://notifications.rishankkesharwani.com/api/v1
NOTIFICATION_MODEL_REGRESSION_API_KEY=mr_notif_live_secret_key_replace_in_production

# Evaluation Worker Configuration
EVAL_WORKER_CONCURRENCY=5
EVAL_CASE_TIMEOUT_MS=30000
MAX_BATCH_SIZE=500

# Frontend Environment Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ACCESS_ENABLED=true
